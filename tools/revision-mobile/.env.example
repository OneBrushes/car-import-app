# Copia este archivo como .env (en esta misma carpeta). .env no se sube a git.

# El mismo secreto que tiene el Worker (npx wrangler secret put LOCAL_REVIEW_TOKEN). Obligatorio.
LOCAL_REVIEW_TOKEN=

# Servidor de la app (no hace falta cambiarlo)
NORDRIVE_API_URL=https://nordrive-mcp.infonordrive.workers.dev

# País de tu conexión de casa: si la IP sale por otro país, se asume VPN y no se revisa
PAIS_CASA=ES

# 1 = al terminar, volver a suspender el PC (solo si nadie lo está usando: 5 min sin teclado ni ratón)
SUSPENDER_AL_TERMINAR=0

# chromium (por defecto, el de Playwright) o chrome (tu Google Chrome instalado)
NAVEGADOR=chromium

# 1 = se ve la ventana del navegador (minimizada); 0 = sin ventana
VISIBLE=1
